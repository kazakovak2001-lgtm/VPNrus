# Beta release signing config template (Day 1 execution, see
# docs/NOVA_VPN_BETA_CUT.md section 6).
#
# Copy this file to `android/app/keystore.properties` (already gitignored -
# see .gitignore) and fill in real values. NEVER commit the copy, and NEVER
# commit the .jks/.keystore file it points at (also already gitignored).
#
# To generate a Beta signing keystore (one-time, keep it safe - losing it
# means every future update needs a new applicationId):
#
#   keytool -genkeypair -v -keystore nova-vpn-beta.jks \
#     -alias nova-vpn-beta -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/app/ (this directory).

storeFile=nova-vpn-beta.jks
storePassword=CHANGE_ME
keyAlias=nova-vpn-beta
keyPassword=CHANGE_ME
