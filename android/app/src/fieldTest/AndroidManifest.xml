<?xml version="1.0" encoding="utf-8"?>
<!--
  Russia field-test build (FIELD_TEST_ONLY) manifest overlay - merged with
  src/main/AndroidManifest.xml ONLY for the `fieldTest` build type (see
  android/app/build.gradle.kts). The normal debug/release manifests are
  completely unaffected - this file does not exist in those variants.

  MainActivity's node is replaced wholesale (tools:node="replace" drops its
  existing intent-filter entirely) so it is no longer the launcher in this
  build - FieldTestActivity is the ONE launcher activity instead, matching
  the task's required UX (open the app, see "Nova VPN" / [Connect], nothing
  else - never the normal app's Home/Settings/activation screens).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:label="@string/app_name">

        <activity
            android:name="net.pocvpn.client.MainActivity"
            android:exported="false"
            tools:node="replace" />

        <activity
            android:name="net.pocvpn.client.fieldtest.FieldTestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
