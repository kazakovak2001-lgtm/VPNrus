<?xml version="1.0" encoding="utf-8"?>
<!--
  B8K1B - debug-only manual entry point for exercising NovaXrayVpnService/
  VlessRealityTransport on a physical device. This file lives in the
  `debug` Gradle source set, so Gradle's manifest merger includes
  XrayDiagnosticsActivity ONLY in debug builds - it is genuinely absent
  from a release APK's merged manifest, not merely hidden behind a
  BuildConfig.DEBUG runtime check.

  B13 (2026-08-30) - exported="true": recent Android versions (confirmed
  on a real device targeting SDK 35+) refuse `adb shell am start` against
  a non-exported component even from the shell UID - exporting is required
  for this activity's own stated purpose ("manually exercising... on a
  physical device" via adb). Still harmless to export: this is a
  DEBUG-BUILD-ONLY activity (absent from any release APK, per this file's
  own scoping above), it performs no action without explicit Intent
  extras a bare launch never supplies, and it saves/reads only real,
  already-provisioned credentials - never fabricates one (see the
  Activity's own class docs).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="net.pocvpn.client.debug.XrayDiagnosticsActivity"
            android:exported="true"
            android:label="Xray Diagnostics (debug)" />

        <!-- B45A - SPIKE ONLY, NOT A PRODUCTION TRANSPORT. Debug-only manual
             entry point for the independent shadowsocks-rust Android
             integration feasibility spike (see
             docs/B45A_SHADOWSOCKS_RUST_SPIKE.md). Lives in this `debug`
             source set fragment exactly like XrayDiagnosticsActivity above -
             genuinely absent from a release APK's merged manifest, never
             merely a BuildConfig.DEBUG runtime check. Never wired into
             TransportRegistry/TransportOrchestrator/SmartConnect - this
             service is reachable ONLY from this manual debug Activity. -->
        <activity
            android:name="net.pocvpn.client.debug.b45a.B45ASpikeActivity"
            android:exported="true"
            android:label="B45A Shadowsocks Spike (debug, not production)" />
        <service
            android:name="net.pocvpn.client.debug.b45a.B45ASpikeVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- B45B-3P - isolated PHYSICAL VALIDATION harness for the PRODUCTION
             Shadowsocks 2022 adapter shell (ShadowsocksTransport/
             ShadowsocksVpnService/ShadowsocksRuntime, all in src/main).
             Never wired into TransportRegistry/TransportOrchestrator/
             SmartConnect/AutoGatewaySelector/PathCandidateBuilder - reachable
             ONLY from this manual debug Activity, same discipline as
             B45ASpikeActivity/XrayDiagnosticsActivity above. exported=true
             for the same `adb shell am start` reason B13 already documented
             on XrayDiagnosticsActivity. -->
        <activity
            android:name="net.pocvpn.client.debug.shadowsocksvalidation.ShadowsocksAdapterValidationActivity"
            android:exported="true"
            android:label="Shadowsocks Adapter Validation (debug, not production)" />

        <!-- B46-3C - RESEARCH ONLY, NOT A PRODUCTION TRANSPORT. Debug-only
             real VpnService proving the COMPLETE process-isolated
             Hysteria2 data-plane path - see
             docs/B46_3C_HYSTERIA_PROCESS_ISOLATED_DATAPLANE.md. Never
             wired into TransportRegistry/TransportOrchestrator/
             SmartConnect. -->
        <service
            android:name="net.pocvpn.client.vpn.hysteria.Tun2SocksHysteriaDataPlaneSpikeVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
