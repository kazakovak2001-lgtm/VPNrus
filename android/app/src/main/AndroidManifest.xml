<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- B8H - makes launchable apps visible to queryIntentActivities() under
         Android 11+ package-visibility filtering, WITHOUT the much broader
         QUERY_ALL_PACKAGES permission - see
         net.pocvpn.client.apps.PackageManagerInstalledAppRepository's own
         docs. This is the officially documented pattern for "show the
         user's list of launchable apps". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NovaVpnApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B-ACT-IMPORT - Android App Link for activation handoff. HTTPS
                 ONLY (never a custom URI scheme as the production mechanism -
                 see ActivationInputResolver's own docs), one explicit
                 production host, one explicit path prefix - never a
                 wildcard host/path. android:autoVerify requires a matching
                 assetlinks.json served from this exact host at
                 /.well-known/assetlinks.json (see
                 docs/ACTIVATION_HANDOFF_CONTRACT.md) - until that is
                 published, Android silently falls back to showing a disambig
                 chooser instead of auto-opening this app, which is a safe,
                 non-broken degraded state, never a security issue.
                 ActivationInputResolver.resolveAppLinkUrl re-validates this
                 SAME host/path at runtime - the manifest filter and the
                 resolver are deliberately kept in sync by both existing as
                 explicit literals, never a wildcard either side could drift
                 out of matching. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="activate.aknova.pp.ua"
                    android:pathPrefix="/a/" />
            </intent-filter>
        </activity>

        <service
            android:name="org.amnezia.awg.backend.GoBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- B8K1B - isolated Xray/VLESS+REALITY adapter shell. Not started by
             VpnController/TransportOrchestrator; driven only by
             VlessRealityTransport (itself unregistered in TransportRegistry)
             and the debug-only manual entry point. See
             net.pocvpn.client.vpn.xray.NovaXrayVpnService's own docs. -->
        <service
            android:name=".vpn.xray.NovaXrayVpnService"
            android:process=":xray"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- B45B-3 - isolated Shadowsocks 2022 adapter shell. Not started by
             VpnController/TransportOrchestrator; SHADOWSOCKS_2022 stays
             NOT_IMPLEMENTED in TransportRegistry (see ShadowsocksTransport's
             own docs) - reachable only from a test constructing
             ShadowsocksTransport directly. -->
        <service
            android:name=".vpn.shadowsocks.ShadowsocksVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- B46-4A - production, process-isolated Hysteria2 adapter. Started
             only by Hysteria2Transport; HYSTERIA2 stays NOT_IMPLEMENTED in
             TransportRegistry's default set (see
             MainViewModel.isHysteria2AvailableFor's own docs) until a real
             trusted signed binding + endpoint-scoped credential + arm64-v8a
             native child eligibility all hold. Same non-exported,
             BIND_VPN_SERVICE-only security boundary as every other VpnService
             above - no debug Activity is required for production. -->
        <service
            android:name=".vpn.hysteria.Hysteria2VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <!-- Field test: the JSON report is shared as a file (too large for
             Intent text). Not exported; read access only via the one-shot
             grant on the share intent; exposes only cache/field-test-share/. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fieldtestshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/field_test_share_paths" />
        </provider>
    </application>
</manifest>
