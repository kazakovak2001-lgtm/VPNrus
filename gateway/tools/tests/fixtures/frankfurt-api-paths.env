# Non-secret path keys of Frankfurt's /etc/pocvpn/api.env, as read in the
# B47 read-only precheck (2026-10-04). Fixture for test_reconcile_unit_paths.
POCVPN_API_TOKEN_STORE_PATH=/var/lib/pocvpn-provision/enrollment-tokens.json
POCVPN_API_TOKEN_LOCK_PATH=/var/lib/pocvpn-provision/.tokens.lock
POCVPN_API_ACTIVATION_STORE_PATH=/var/lib/pocvpn-activation/activations.json
POCVPN_API_ACTIVATION_LOCK_PATH=/var/lib/pocvpn-activation/.activations.lock
POCVPN_API_XRAY_STORE_PATH=/var/lib/pocvpn-xray/xray-identities.json
POCVPN_API_XRAY_LOCK_PATH=/var/lib/pocvpn-xray/xray-identities.json.lock
POCVPN_API_XRAY_STAGING_CONFIG_PATH=/var/lib/pocvpn-xray/staging/candidate-config.json
POCVPN_API_XRAY_ACTIVATION_LOCK_PATH=/var/lib/pocvpn-xray/xray-activation.lock
POCVPN_API_XRAY_ACTIVATION_LAST_HASH_PATH=/var/lib/pocvpn-xray/xray-activation.last-sha256
