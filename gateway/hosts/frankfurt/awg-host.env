# B47 Frankfurt - install as /etc/pocvpn/awg-host.env (root:root 0644).
# Read by lib/common.sh load_host_overrides (parsed, never sourced; only
# SERVICE_NAME is accepted). Frankfurt's awg0 is run by the distro template
# unit awg-quick@awg0.service (read-only precheck 2026-10-04: awg-poc.service
# is not-found there), so the repo default SERVICE_NAME=awg-poc made every
# live reload a silent no-op.
SERVICE_NAME=awg-quick@awg0
