#!/usr/sbin/nft -f
#
# Scope: forwarding + NAT for the AmneziaWG tunnel only, in our OWN table
# (inet pocvpn). This never touches any other nftables table or the host's
# existing firewall (ufw, etc.) - we only add, never flush unrelated rules.
#
# Idempotent by construction: `table inet __NFT_TABLE__` creates the table
# if missing (no-op if it already exists), then `delete table` removes
# whatever was there, then it is fully redeclared below - safe to re-run.
#
# Rendered by provision.sh: __AWG_IFACE__, __EGRESS_IFACE__, __AWG_SUBNET__.

table inet __NFT_TABLE__
delete table inet __NFT_TABLE__

table inet __NFT_TABLE__ {
    # Exit Target ACL - MUST equal gateway/api/exit_target_policy.py
    # (enforced by api/tests/test_exit_target_policy.py). Destinations a
    # tunnel client may never reach through this gateway: loopback,
    # RFC 1918 (incl. the AWS VPC), CGNAT, link-local (incl. EC2 metadata
    # 169.254.169.254), multicast and other special-purpose space. No
    # ::ffff:0:0/96 entry: IPv4-mapped space is covered by the IPv4 set.
    set exit_blocked_v4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
            203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4
        }
    }

    set exit_blocked_v6 {
        type ipv6_addr
        flags interval
        elements = {
            ::/128, ::1/128, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64,
            2001:db8::/32, fc00::/7, fe80::/10, fec0::/10, ff00::/8
        }
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept

        # Exit Target ACL: tunnel-originated NEW flows to blocked space are
        # rejected here, in the forward hook - before postrouting's
        # masquerade, and before the accept below. Only traffic ENTERING
        # from the tunnel is matched, so return traffic and ICMP errors
        # (PMTUD "fragmentation needed", incl. from private-addressed
        # routers - also ct related) are untouched, and public ICMP works.
        iifname "__AWG_IFACE__" ip daddr @exit_blocked_v4 reject with icmpx type admin-prohibited
        iifname "__AWG_IFACE__" ip6 daddr @exit_blocked_v6 reject with icmpx type admin-prohibited

        # Only the AWG tunnel <-> detected egress interface may forward.
        # Everything else through this table's forward hook is dropped
        # (default-deny except the required VPN path).
        iifname "__AWG_IFACE__" oifname "__EGRESS_IFACE__" accept
        iifname "__EGRESS_IFACE__" oifname "__AWG_IFACE__" accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        # NAT/masquerade tunnel client traffic out through the egress interface.
        ip saddr __AWG_SUBNET__ oifname "__EGRESS_IFACE__" masquerade
    }
}
