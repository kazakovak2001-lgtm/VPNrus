# B36 - non-secret bootstrap-tunnel facts, safe to commit.
#
# BOOTSTRAP_CLIENT_PUBLIC_KEY is a WireGuard/AmneziaWG PUBLIC key - by
# design the SAME value shipped in every installed APK
# (android/app/src/main/java/net/pocvpn/client/bootstrap/BootstrapIdentity.kt's
# BOOTSTRAP_PUBLIC_KEY_BASE64) - never a secret, exactly like every other
# gateway's own AWG public key already committed in
# ProductionGatewayCatalog. Security comes from the restricted nftables
# table this identity is bound to (pocvpn-bootstrap.nft.template), never
# from this value being hidden.
#
# The SAME identity is used on BOTH Frankfurt and Stockholm (see
# docs/B36_SERVER_DEPLOYMENT_PLAN.md's own "one identity, not two" section
# for why this is safe - each gateway's AmneziaWG interface is an
# independent peer list, so one client keypair being a valid peer on two
# unrelated servers carries no additional risk beyond what a normal AWG
# client already accepts by having two gateway peers configured).
BOOTSTRAP_CLIENT_PUBLIC_KEY=I/Kv8Kkebdtb5Rem+vdmkq0N3DK/ojQVbQWtoOFxyFE=

# This peer's fixed AmneziaWG tunnel-interface address on EACH gateway
# (independent per-gateway subnets - no collision risk, see poc.env's own
# AWG_SUBNET_CIDR=10.77.0.0/24). Must match
# BootstrapIdentity.CLIENT_TUNNEL_ADDRESS_CIDR's host part on the client.
BOOTSTRAP_CLIENT_TUNNEL_IP=10.77.0.250

# The dedicated, additive nftables table name used ONLY to restrict this
# one peer - never reuses or edits the existing production forward/NAT
# ruleset on EITHER gateway (Frankfurt's iptables-nft `ip filter`/`ip nat`,
# or Stockholm's native `inet pocvpn` - see
# docs/B36_SERVER_DEPLOYMENT_PLAN.md's per-host runtime sections). The SAME
# table name/template is used on both hosts - this table's own shape does
# not depend on which production firewall implementation coexists with it.
BOOTSTRAP_NFT_TABLE=pocvpn_bootstrap

# The bootstrap table's own FORWARD-hook priority - MUST be numerically
# lower than either production runtime's own FORWARD-hook priority (both
# verified at 0: Frankfurt's `ip filter` uses the standard legacy
# NF_IP_PRI_FILTER=0; Stockholm's `inet pocvpn` uses nftables' own named
# priority "filter", which also resolves to 0) so this table's DROP is
# dispatched first - see gateway/lib/bootstrap_runtime.sh for the full
# netfilter hook-priority reasoning and the live verification that checks
# this against the REAL running ruleset before ever applying anything.
BOOTSTRAP_FORWARD_PRIORITY=-5

# The bootstrap table's own INPUT-hook priority - explicit and independent
# of the FORWARD value above (separate hook, separate kernel dispatch
# order). Previously this table's `input` chain used nftables' named
# priority "filter" (0), relying on same-priority base-chain ordering
# (registration/insertion order) against either production runtime's own
# INPUT chain - never guaranteed by the netfilter core, so never a safe
# assumption. Set to the same safe earlier value as BOOTSTRAP_FORWARD_
# PRIORITY unless live runtime evidence on a given host requires a
# different value - install-bootstrap-peer.sh verifies this against the
# REAL running ruleset (where a production INPUT hook exists at all)
# before ever applying the bootstrap table, exactly like the FORWARD
# value above.
BOOTSTRAP_INPUT_PRIORITY=-5
