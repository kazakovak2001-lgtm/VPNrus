# B37 - Shared, NON-SECRET AmneziaWG 3.1 FIELD-TEST profile for the isolated
# `awg-ft31` interface. Deliberately SEPARATE from `awg-profile.env` (the
# production `awg0` profile) - never sourced by provision.sh/add-peer.sh,
# only by provision-ft31.sh/rollback-ft31.sh.
#
# These exact values are declared identically here and in
# android/app/src/fieldTest/java/net/pocvpn/client/fieldtest/FieldTestAwg31GatewayCatalog.kt
# so both ends of the isolated tunnel use one declared profile.
#
# Per the pinned amneziawg-go README (v3.1.20260814, fetched 2026-09-06 - see
# B37 task report): Jc/Jmin/Jmax, I1-I5, ContentPaddingAddition are
# documented client-side-only; S1-S4/H1-H4 are used by the RECEIVER to
# identify incoming packet types (this repo's own PocAwgProfile "B8B3B
# correction" already found a case where a "client-side only" classification
# for these exact fields was WRONG for the live production awg0) so they are
# declared identically on both ends here, same as production. Only
# HeaderProtectionKey is genuinely secret - it is NOT in this file:
# provision-ft31.sh generates it itself, on-host, via `awg genkey` at deploy
# time and writes it directly into the rendered, never-committed
# awg-ft31.conf (mode 600) - it is never an input to this script, never an
# env var, never committed.
#
# Do not add secrets to this file.

AWG_FT31_JC=6
AWG_FT31_JMIN=40
AWG_FT31_JMAX=100
AWG_FT31_S1=15
AWG_FT31_S2=20
AWG_FT31_S3=15
AWG_FT31_S4=20
AWG_FT31_H1=1190494288
AWG_FT31_H2=1190494289
AWG_FT31_H3=1190494290
AWG_FT31_H4=1190494291
AWG_FT31_I1="<r 40>"
AWG_FT31_I2="<r 60>"
AWG_FT31_I3="<r 30>"
AWG_FT31_I4="<r 50>"
AWG_FT31_I5="<t>"
AWG_FT31_CONTENT_PADDING_ADDITION="0-64"
AWG_FT31_RANDOM_TRAILERS=off
AWG_FT31_DISABLE_COOKIES=off
