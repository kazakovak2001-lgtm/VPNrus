# B26 (task F/H/J) - tracked TEMPLATE for /etc/pocvpn/ingress.env
# (root:pocvpn-api, 0640 - same ownership discipline as api.env.example).
# Contains NO real secrets - every value below is a placeholder or a
# non-secret operational parameter. Copy to /etc/pocvpn/ingress.env, fill
# in real values out of band, never commit the filled-in file.
#
# This is a SINGLE combined env file (used by
# gateway/systemd/pocvpn-api-ingress.service) carrying BOTH the AWG-shaped
# POCVPN_API_* fields config.py's load_config() structurally requires
# (see _REQUIRED_KEYS - this is a stable, unconditional requirement of the
# shared pocvpn-api process, not something this slice changes) AND this
# host's own ingress-role NOVA_INGRESS_* fields (ingress_config.py).

# =====================================================================
# POCVPN_API_* - structurally required by config.py even though a
# DIRECT_IP-ingress-only host has no real AWG gateway of its own. These
# four MUST be present and well-formed for the process to start at all;
# they are otherwise INERT on an ingress-only host (POST /v1/peers is
# never called against this host in practice - point DNS/clients at the
# real gateways for that). Use clearly-fake-but-well-formed placeholders,
# never a real gateway's own key/IP.
POCVPN_API_ENDPOINT_HOST=REPLACE_WITH_THIS_HOSTS_PUBLIC_IP
POCVPN_API_ENDPOINT_PORT=51820
POCVPN_API_GATEWAY_PUBLIC_KEY=REPLACE_WITH_ANY_WELL_FORMED_UNUSED_WG_KEY
POCVPN_API_GATEWAY_TUNNEL_IP=10.255.255.1
POCVPN_API_API_PORT=8443
POCVPN_API_TOKEN_STORE_PATH=/var/lib/pocvpn-provision-ingress/enrollment-tokens.json
POCVPN_API_TOKEN_LOCK_PATH=/var/lib/pocvpn-provision-ingress/.tokens.lock
# A harmless no-op script (`#!/bin/sh\nexit 99`) - /v1/peers is never
# meant to be called on an ingress-only host, but config.py still
# requires this path to exist and be a file at startup.
POCVPN_API_PROVISION_SCRIPT_PATH=/usr/local/libexec/pocvpn-noop-provision-peer
POCVPN_API_SUBPROCESS_TIMEOUT_SECONDS=15

# =====================================================================
# The activation boundary /v1/ingress-profile reuses (task G's "no second
# identity system") - THIS host's own dedicated activation store, never
# shared with a real gateway. Issue credentials the same way an ordinary
# gateway would (gateway/tools/activation_tokens.py against THIS store).
POCVPN_API_ACTIVATION_STORE_PATH=/var/lib/pocvpn-provision-ingress/activations.json
POCVPN_API_ACTIVATION_LOCK_PATH=/var/lib/pocvpn-provision-ingress/.activations.lock

# =====================================================================
# NOVA_INGRESS_* - the real ingress role configuration (ingress_config.py).
NOVA_INGRESS_ENDPOINT_ID=REPLACE_WITH_A_STABLE_INGRESS_ID_e.g._ru-ingress-1
NOVA_INGRESS_ENDPOINT_HOST=REPLACE_WITH_THIS_HOSTS_PUBLIC_IP

# --- client-facing REALITY inbound ---
NOVA_INGRESS_REALITY_PRIVATE_KEY_FILE=/etc/pocvpn/ingress/reality-private-key.txt
NOVA_INGRESS_SERVER_PORT=8443
NOVA_INGRESS_SERVER_NAME=REPLACE_WITH_A_REAL_UNRELATED_HTTPS_CAMOUFLAGE_DOMAIN
NOVA_INGRESS_DEST=REPLACE_WITH_SAME_DOMAIN:443
NOVA_INGRESS_SHORT_ID=REPLACE_WITH_HEX_SHORT_ID
NOVA_INGRESS_FINGERPRINT=chrome
NOVA_INGRESS_REALITY_PUBLIC_KEY=REPLACE_WITH_THIS_INGRESS_REALITY_PUBLIC_KEY
NOVA_INGRESS_FLOW=xtls-rprx-vision

# --- optional client-facing TLS inbound (leave ALL blank to disable) ---
NOVA_INGRESS_TLS_SERVER_PORT=
NOVA_INGRESS_TLS_SERVER_NAME=
NOVA_INGRESS_TLS_FINGERPRINT=
NOVA_INGRESS_TLS_CERT_FILE=
NOVA_INGRESS_TLS_KEY_FILE=

# --- ingress -> exit upstream relay identity (task H - the pinned EXIT) ---
NOVA_INGRESS_UPSTREAM_HOST=REPLACE_WITH_THE_PINNED_EXITS_HOST
NOVA_INGRESS_UPSTREAM_PORT=REPLACE_WITH_THE_PINNED_EXITS_XRAY_PORT
NOVA_INGRESS_UPSTREAM_TRANSPORT=reality
NOVA_INGRESS_UPSTREAM_UUID_FILE=/etc/pocvpn/ingress/upstream-relay-uuid.txt
NOVA_INGRESS_UPSTREAM_SERVER_NAME=REPLACE_WITH_EXITS_REALITY_CAMOUFLAGE_DOMAIN
NOVA_INGRESS_UPSTREAM_PUBLIC_KEY=REPLACE_WITH_EXITS_REALITY_PUBLIC_KEY
NOVA_INGRESS_UPSTREAM_SHORT_ID=REPLACE_WITH_EXITS_SHORT_ID
NOVA_INGRESS_UPSTREAM_SNI=

# --- B26 (task B/C) - the real end-to-end proof contract ---
NOVA_INGRESS_EXIT_ENDPOINT_ID=REPLACE_WITH_THE_PINNED_EXITS_STABLE_ENDPOINT_ID
NOVA_INGRESS_EXIT_PROBE_HOST=REPLACE_WITH_THE_PINNED_EXITS_PUBLIC_HTTPS_HOST
NOVA_INGRESS_PROBE_HMAC_SECRET_FILE=/etc/pocvpn/ingress/probe-hmac-secret.txt
NOVA_INGRESS_PROBE_TTL_SECONDS=300

# --- this host's own durable activation/identity stores ---
NOVA_INGRESS_ACTIVATION_STORE_PATH=/var/lib/pocvpn-provision-ingress/activations.json
NOVA_INGRESS_ACTIVATION_LOCK_PATH=/var/lib/pocvpn-provision-ingress/.activations.lock
NOVA_INGRESS_XRAY_STORE_PATH=/var/lib/pocvpn-provision-ingress/xray-identities.json
NOVA_INGRESS_XRAY_LOCK_PATH=/var/lib/pocvpn-provision-ingress/.xray-identities.lock

# --- the render/validate/stage/apply boundary (task F) ---
NOVA_INGRESS_ACTIVATION_WRAPPER_PATH=/usr/local/libexec/nova-xray-ingress-reload
NOVA_INGRESS_STAGING_CONFIG_PATH=/var/lib/pocvpn-provision-ingress/xray/candidate-config.json
NOVA_INGRESS_ACTIVATION_GLOBAL_LOCK_PATH=/var/lib/pocvpn-provision-ingress/xray/.activation.lock
NOVA_INGRESS_ACTIVATION_LAST_HASH_PATH=/var/lib/pocvpn-provision-ingress/xray/.last-activated-hash
NOVA_INGRESS_ACTIVATION_TIMEOUT_SECONDS=15
NOVA_INGRESS_SUDO_PATH=/usr/bin/sudo

# --- profile validity window handed to a device (task C/E) ---
NOVA_INGRESS_PROFILE_TTL_SECONDS=2592000

# Do NOT add here:
#   - the ingress's own REALITY private key (file path only, above)
#   - the ingress->exit upstream relay uuid (file path only, above)
#   - the ingress<->exit probe HMAC secret (file path only, above)
#   - anything from a real gateway's own api.env
