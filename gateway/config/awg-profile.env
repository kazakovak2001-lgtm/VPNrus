# Shared, NON-SECRET AmneziaWG 3.1 POC-01 profile.
#
# These exact values are declared identically here and in
# android/app/src/main/java/net/pocvpn/client/vpn/config/PocAwgProfile.kt
# so both ends of the tunnel use one declared POC profile - not because the
# protocol requires bilateral agreement on all of them (see below), but for
# POC-01 consistency and to have one reviewable source of truth.
#
# Per the pinned amneziawg-go README at commit 1b86b2ae0e49
# (tag v3.1.20260814, exact commit this gateway is built from - see
# build-awg.sh): only HeaderProtectionKey is documented "server-side"
# (mandatory - must be byte-identical on both ends). Jc/Jmin/Jmax, S1-S4,
# H1-H4, I1-I5, ContentPaddingAddition, and the rekey/timeout/keepalive
# timing fields are documented "client-side" (not required to match the
# peer) - junk/padding/signature packets carry no real data, so the
# receiving side does not need to know the sender's exact values.
# RandomTrailers/DisableCookies are new in this commit and not yet covered
# by that README section; they are treated the same way here (declared
# once, used on both ends) as an assumption, not a confirmed protocol
# requirement - flagged as such in gateway/README.md.
#
# HeaderProtectionKey is intentionally NOT set for POC-01: it is an
# additional shared secret (generated via `awg genkey`, like a PSK) and
# requires >=12 for all of S1-S4 when enabled. Deferred to a later slice -
# see gateway/README.md "Known limitations".
#
# Do not add secrets to this file.

AWG_JC=6
AWG_JMIN=40
AWG_JMAX=100
AWG_S1=15
AWG_S2=20
AWG_S3=15
AWG_S4=20
AWG_H1=1190494288
AWG_H2=1190494289
AWG_H3=1190494290
AWG_H4=1190494291
AWG_RANDOM_TRAILERS=off
AWG_DISABLE_COOKIES=off
