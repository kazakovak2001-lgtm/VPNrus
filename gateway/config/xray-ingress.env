# B26 (task F) - the ingress-role counterpart of xray.env: non-secret
# path/service configuration for gateway/scripts/xray-activate.sh when
# invoked via gateway/privileged/nova-xray-ingress-reload (which sets
# XRAY_ACTIVATE_ENV_FILE to point here instead of the default xray.env -
# see that script's own docs). Same discipline as xray.env: fixed,
# non-secret operational parameters only. No REALITY key material, no
# upstream relay uuid, no probe HMAC secret - ever - belongs in this file.

# Pinned, versioned install path - same binary the regular gateway role
# uses (see gateway/xray/fetch-xray-server.sh and gateway/xray/VERSION).
XRAY_BIN_PATH=/opt/pocvpn/xray/v26.7.28/xray

# Written by pocvpn-api's ingress role (gateway/api/ingress_activation.py,
# via NOVA_INGRESS_STAGING_CONFIG_PATH) - readable by root, NOT
# world-readable (0600, pocvpn-api:pocvpn-api). Deliberately a SEPARATE
# path/directory from the regular gateway role's own staging file, even on
# a host that (temporarily) runs both roles for testing - see
# docs/B26_FIRST_INGRESS_RUNBOOK.md's isolation notes.
XRAY_STAGING_CONFIG=/var/lib/pocvpn-provision-ingress/xray/candidate-config.json

# The live config directory/file nova-xray-ingress.service actually reads -
# a SEPARATE systemd unit/config tree from the regular gateway role's own
# nova-xray.service/config, so the two can coexist on one host without
# either one's activation ever touching the other's live config.
XRAY_LIVE_CONFIG_DIR=/etc/nova-xray-ingress
XRAY_LIVE_CONFIG=/etc/nova-xray-ingress/config.json
XRAY_BACKUP_CONFIG=/etc/nova-xray-ingress/config.json.previous

XRAY_LIVE_CONFIG_OWNER=root
XRAY_LIVE_CONFIG_GROUP=nova-xray-ingress
XRAY_LIVE_CONFIG_MODE=0640

XRAY_SERVICE_NAME=nova-xray-ingress
