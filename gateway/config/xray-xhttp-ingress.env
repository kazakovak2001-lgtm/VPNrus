# B35: non-secret activation coordinates for the isolated Stockholm XHTTP ingress.
# The wrapper selects this file with a fixed environment; no caller-supplied paths.
XRAY_BIN_PATH=/opt/pocvpn/xray/v26.7.28/xray
XRAY_STAGING_CONFIG=/var/lib/pocvpn-provision-xhttp-ingress/xray/candidate-config.json
XRAY_LIVE_CONFIG_DIR=/etc/nova-xray-xhttp-ingress
XRAY_LIVE_CONFIG=/etc/nova-xray-xhttp-ingress/config.json
XRAY_BACKUP_CONFIG=/etc/nova-xray-xhttp-ingress/config.json.previous
XRAY_LIVE_CONFIG_OWNER=root
XRAY_LIVE_CONFIG_GROUP=nova-xray-ingress
XRAY_LIVE_CONFIG_MODE=0640
XRAY_SERVICE_NAME=nova-xray-xhttp-ingress
