# B8K2A - non-secret path/service configuration for the Xray activation
# boundary (gateway/scripts/xray-activate.sh + gateway/privileged/nova-xray-reload).
# Mirrors gateway/config/poc.env's own role for the AWG side - fixed,
# non-secret operational parameters only. No REALITY key material, no
# credentials, ever belongs in this file.

# Pinned, versioned install path - see gateway/xray/fetch-xray-server.sh
# and gateway/xray/VERSION. Update deliberately when bumping VERSION.
XRAY_BIN_PATH=/opt/pocvpn/xray/v26.7.28/xray

# Written by pocvpn-api (gateway/api/xray_reload.py) - readable by root,
# NOT world-readable (0600, pocvpn-api:pocvpn-api). This is the ONLY path
# pocvpn-api itself ever writes in this whole boundary.
XRAY_STAGING_CONFIG=/var/lib/pocvpn-provision/xray/candidate-config.json

# The live config directory/file nova-xray.service actually reads. Not
# writable by pocvpn-api - see gateway/systemd/nova-xray.service and
# gateway/xray/README.md's ownership model.
XRAY_LIVE_CONFIG_DIR=/etc/nova-xray
XRAY_LIVE_CONFIG=/etc/nova-xray/config.json
XRAY_BACKUP_CONFIG=/etc/nova-xray/config.json.previous

XRAY_LIVE_CONFIG_OWNER=root
XRAY_LIVE_CONFIG_GROUP=nova-xray
XRAY_LIVE_CONFIG_MODE=0640

XRAY_SERVICE_NAME=nova-xray
