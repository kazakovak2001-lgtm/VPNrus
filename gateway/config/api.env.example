# B8B1C3: tracked TEMPLATE for /etc/pocvpn/api.env (root:pocvpn-api, 0640 -
# see gateway/DEPLOYMENT.md). This file contains NO real secrets - every
# value below is a placeholder or a non-secret operational parameter. Copy
# it to /etc/pocvpn/api.env and fill in the real values out of band; never
# commit the filled-in file.
#
# Every key here is read by gateway/api/config.py's load_config() - see
# that module for the exact validation each one is held to at startup.
# The API's listen address is NEVER configurable from this file or
# anywhere else - it is hard-coded to 127.0.0.1 in gateway/api/server.py.

POCVPN_API_ENDPOINT_HOST=vpn.example.invalid
POCVPN_API_ENDPOINT_PORT=51820
POCVPN_API_GATEWAY_PUBLIC_KEY=REPLACE_WITH_GATEWAY_AWG_PUBLIC_KEY
POCVPN_API_GATEWAY_TUNNEL_IP=10.77.0.1

# Localhost-only port this service itself listens on.
POCVPN_API_API_PORT=8443

POCVPN_API_TOKEN_STORE_PATH=/var/lib/pocvpn-provision/enrollment-tokens.json
POCVPN_API_TOKEN_LOCK_PATH=/var/lib/pocvpn-provision/.tokens.lock

POCVPN_API_PROVISION_SCRIPT_PATH=/usr/local/libexec/pocvpn-provision-peer
POCVPN_API_SUDO_PATH=/usr/bin/sudo

# Bounded subprocess timeout for the sudo -> root-helper -> provision-
# peer.sh call - see gateway/api/provision.py. Keep this comfortably above
# provision-peer.sh's own worst-case (lock contention + one systemctl
# reload) but still well under any HTTP client's own timeout.
POCVPN_API_SUBPROCESS_TIMEOUT_SECONDS=15

# B8C1 - optional. Blank (the default, and this template's default) means
# POST /v1/activate is not configured and always fails closed with 503 -
# see gateway/api/activations.py for the store format and
# gateway/tools/activation_tokens.py for the operator CLI that
# initializes/issues/revokes activations. Unlike POCVPN_API_TOKEN_STORE_PATH
# above, this store IS written by the running pocvpn-api process itself
# (device binding on first use) - its directory/file ownership must grant
# pocvpn-api write access, not just read, when this is actually deployed.
POCVPN_API_ACTIVATION_STORE_PATH=
POCVPN_API_ACTIVATION_LOCK_PATH=

# B8K2 - optional. Blank/zero (the default, and this template's default)
# means POST /v1/xray-profile is not configured and always fails closed
# with 503 - see gateway/api/xray_provisioning.py for the store format.
# Reuses POCVPN_API_ACTIVATION_STORE_PATH/LOCK_PATH above for eligibility -
# these are its OWN, separate durable store, not a duplicate of the
# activation store. Every value below except the store/lock paths is
# PUBLIC-by-design (safe to hand to any authenticated, eligible client) -
# the REALITY server PRIVATE key deliberately has NO field here at all;
# see gateway/xray/README.md's key-management model for where it actually
# lives (only inside the rendered Xray server config file, never in this
# API process).
POCVPN_API_XRAY_STORE_PATH=
POCVPN_API_XRAY_LOCK_PATH=
POCVPN_API_XRAY_SERVER_PORT=
POCVPN_API_XRAY_SERVER_NAME=
POCVPN_API_XRAY_FINGERPRINT=
POCVPN_API_XRAY_REALITY_PUBLIC_KEY=
POCVPN_API_XRAY_SHORT_ID=
POCVPN_API_XRAY_FLOW=

# Do NOT add here:
#   - a bearer token (tokens are issued/stored by gateway/tools/
#     enrollment_tokens.py, never placed in this file)
#   - the gateway's AmneziaWG/WireGuard server private key
#   - the Android client's private key
#   - the Xray REALITY server private key (see gateway/xray/README.md)
#   - a bind-host override (there is no such setting - see above)
