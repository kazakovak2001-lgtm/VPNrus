# B8B1C3: tracked TEMPLATE for /etc/pocvpn/api.env (root:pocvpn-api, 0640 -
# see gateway/DEPLOYMENT.md). This file contains NO real secrets - every
# value below is a placeholder or a non-secret operational parameter. Copy
# it to /etc/pocvpn/api.env and fill in the real values out of band; never
# commit the filled-in file.
#
# Every key here is read by gateway/api/config.py's load_config() - see
# that module for the exact validation each one is held to at startup.
# The API's listen address is NEVER configurable from this file or
# anywhere else - it is hard-coded to 127.0.0.1 in gateway/api/server.py.

POCVPN_API_ENDPOINT_HOST=vpn.example.invalid
POCVPN_API_ENDPOINT_PORT=51820
POCVPN_API_GATEWAY_PUBLIC_KEY=REPLACE_WITH_GATEWAY_AWG_PUBLIC_KEY
POCVPN_API_GATEWAY_TUNNEL_IP=10.77.0.1

# Localhost-only port this service itself listens on.
POCVPN_API_API_PORT=8443

POCVPN_API_TOKEN_STORE_PATH=/var/lib/pocvpn-provision/enrollment-tokens.json
POCVPN_API_TOKEN_LOCK_PATH=/var/lib/pocvpn-provision/.tokens.lock

POCVPN_API_PROVISION_SCRIPT_PATH=/usr/local/libexec/pocvpn-provision-peer
POCVPN_API_SUDO_PATH=/usr/bin/sudo

# Bounded subprocess timeout for the sudo -> root-helper -> provision-
# peer.sh call - see gateway/api/provision.py. Keep this comfortably above
# provision-peer.sh's own worst-case (lock contention + one systemctl
# reload) but still well under any HTTP client's own timeout.
POCVPN_API_SUBPROCESS_TIMEOUT_SECONDS=15

# B8C1 - optional. Blank (the default, and this template's default) means
# POST /v1/activate is not configured and always fails closed with 503 -
# see gateway/api/activations.py for the store format and
# gateway/tools/activation_tokens.py for the operator CLI that
# initializes/issues/revokes activations. Unlike POCVPN_API_TOKEN_STORE_PATH
# above, this store IS written by the running pocvpn-api process itself
# (device binding on first use) - its directory/file ownership must grant
# pocvpn-api write access, not just read, when this is actually deployed.
POCVPN_API_ACTIVATION_STORE_PATH=
POCVPN_API_ACTIVATION_LOCK_PATH=

# B8K2 - optional. Blank/zero (the default, and this template's default)
# means POST /v1/xray-profile is not configured and always fails closed
# with 503 - see gateway/api/xray_provisioning.py for the store format.
# Reuses POCVPN_API_ACTIVATION_STORE_PATH/LOCK_PATH above for eligibility -
# these are its OWN, separate durable store, not a duplicate of the
# activation store. Every value below except the store/lock paths is
# PUBLIC-by-design (safe to hand to any authenticated, eligible client) -
# the REALITY server PRIVATE key deliberately has NO field here at all;
# see gateway/xray/README.md's key-management model for where it actually
# lives (only inside the rendered Xray server config file, never in this
# API process).
POCVPN_API_XRAY_STORE_PATH=
POCVPN_API_XRAY_LOCK_PATH=
POCVPN_API_XRAY_SERVER_PORT=
POCVPN_API_XRAY_SERVER_NAME=
POCVPN_API_XRAY_FINGERPRINT=
POCVPN_API_XRAY_REALITY_PUBLIC_KEY=
POCVPN_API_XRAY_SHORT_ID=
POCVPN_API_XRAY_FLOW=

# B8K2A - the activation boundary: render -> stage -> privileged validate/
# publish/reload (see gateway/api/xray_activation.py and
# gateway/api/config.py's own completeness check). Blank (this template's
# default) is fine ONLY if every Xray field above is ALSO blank - once any
# XRAY_* setting above is set, config.py requires every field in this
# group to be set too, or the process refuses to start. Not a duplicate of
# the client-facing fields above: these are server-only operational paths,
# never returned to a client.
#
# Absolute path to a root-readable-only file containing the REALITY
# private key (raw, one line, no other content) - see
# gateway/xray/README.md's key-management model. NEVER this repo, NEVER
# committed, NEVER the same file/permissions as anything pocvpn-api itself
# writes.
POCVPN_API_XRAY_REALITY_PRIVATE_KEY_FILE=
# Where pocvpn-api stages a freshly rendered candidate Xray server config
# for the privileged wrapper to validate/publish - must be writable by the
# pocvpn-api service account only (see gateway/config/xray.env's
# XRAY_STAGING_CONFIG, which must name this SAME path).
POCVPN_API_XRAY_STAGING_CONFIG_PATH=/var/lib/pocvpn-provision/xray/candidate-config.json
# Global lock serializing every render->stage->validate->publish->reload
# transaction (gateway/api/xray_activation.py's activate_if_needed) - a
# plain empty file pocvpn-api creates on first use, never hand-edited.
POCVPN_API_XRAY_ACTIVATION_LOCK_PATH=/var/lib/pocvpn-provision/xray/.activation.lock
# Small pocvpn-api-owned fingerprint file recording the sha256 of the last
# successfully activated config - what lets an idempotent retry skip
# re-invoking the privileged wrapper (and therefore skip restarting
# nova-xray.service) when nothing has actually changed.
POCVPN_API_XRAY_ACTIVATION_LAST_HASH_PATH=/var/lib/pocvpn-provision/xray/.last-activated-hash
# Absolute path to the root-owned privileged wrapper (see
# gateway/privileged/nova-xray-reload and gateway/privileged/
# pocvpn-api.sudoers) - invoked via POCVPN_API_SUDO_PATH above, takes zero
# arguments.
POCVPN_API_XRAY_ACTIVATION_WRAPPER_PATH=/usr/local/libexec/nova-xray-reload
# Bounded subprocess timeout for the sudo -> nova-xray-reload ->
# xray-activate.sh call (validate + atomic publish + systemctl restart).
# Keep comfortably above that worst case but still well under any HTTP
# client's own timeout - mirrors POCVPN_API_SUBPROCESS_TIMEOUT_SECONDS'
# own reasoning for the AWG side.
POCVPN_API_XRAY_ACTIVATION_TIMEOUT_SECONDS=15
# The REAL external TLS target REALITY camouflages as - must be the SAME
# hostname as POCVPN_API_XRAY_SERVER_NAME above (config.py enforces this),
# and must NEVER be this gateway's own POCVPN_API_ENDPOINT_HOST. Format
# "host:port", e.g. a real, unrelated, always-on HTTPS site.
POCVPN_API_XRAY_DEST=

# B31 - optional, this deployment acting as an EXIT some INGRESS relays
# traffic toward (see gateway/api/config.py's own docs on both fields,
# gateway/tools/apply_relay_upstream_identity.py, and
# docs/B31_INGRESS_PRODUCTION_READINESS.md). Blank (this template's
# default) means: zero static relay clients authorized, and GET
# /v1/relay-health always fails closed with 503 - byte-for-byte the
# pre-B26 behavior for every existing gateway deployment. Neither field
# holds a secret directly - both are FILE PATHS this process reads
# transiently at render/verify time, never inline values, never logged.
#
# Operator-maintained file (gateway/tools/apply_relay_upstream_identity.py
# apply/revoke ONLY - this process only ever reads it) naming the
# ingress->exit relay identities this EXIT authorizes unconditionally.
POCVPN_API_STATIC_RELAY_CLIENTS_FILE=
# Absolute path to a root-readable-only file holding the SAME HMAC secret
# bytes the pinned INGRESS was provisioned with
# (gateway/tools/provision_relay_upstream_identity.py) - verifies the
# short-lived relay probe token GET /v1/relay-health receives, never a
# long-lived/global credential.
POCVPN_API_RELAY_PROBE_HMAC_SECRET_FILE=

# Do NOT add here:
#   - a bearer token (tokens are issued/stored by gateway/tools/
#     enrollment_tokens.py, never placed in this file)
#   - the gateway's AmneziaWG/WireGuard server private key
#   - the Android client's private key
#   - the Xray REALITY server private key (see gateway/xray/README.md -
#     it lives ONLY in the file POCVPN_API_XRAY_REALITY_PRIVATE_KEY_FILE
#     points at, never inline in this file)
#   - a bind-host override (there is no such setting - see above)
