# Secrets - never commit
*.key
*.pem
*.conf
!*.conf.template
# B8B2A - narrow exceptions for the two tracked, non-secret nginx vhost
# templates (no private key material, no tokens - see their own headers).
!gateway/edge/nginx-pocvpn-bootstrap.conf
!gateway/edge/nginx-pocvpn.conf
!gateway/edge/nginx-pocvpn-stockholm.conf
.env
.env.*
!.env.example
local.properties
**/secrets/
*.jks
*.keystore
!debug.keystore

# Python bytecode cache (never intentional - regenerated on any test run)
__pycache__/
*.pyc

# Android / Gradle
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Gradle wrapper distribution cache (not the wrapper jar itself)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Native submodule build artifacts
android/tunnel/tools/amneziawg-tools/
android/**/obj/
android/**/libs/

# Server-side generated peer configs (contain private keys)
gateway/generated/
gateway/wg-keys/
android/app/build/

# Developer-local, non-secret-but-still-gitignored gateway config for manual
# testing (B7C) - contains a real server public key + endpoint once a VPS
# exists. Never committed.
android/app/gateway-dev.properties
