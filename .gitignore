# Native submodule build artifacts
android/tunnel/tools/amneziawg-tools/
android/**/obj/
android/**/libs/

# Server-side generated peer configs (contain private keys)
gateway/generated/
gateway/wg-keys/
android/app/build/

# Developer-local, non-secret-but-still-gitignored gateway config for manual
# testing (B7C) - contains a real server public key + endpoint once a VPS
# exists. Never committed.
android/app/gateway-dev.properties

# B45A - independent shadowsocks-rust spike binary (debug-only, see
# docs/B45A_SHADOWSOCKS_RUST_SPIKE.md Section 26). A locally-built ELF
# binary, not source, and not meant to ever be committed per the B45A git
# rules - kept gitignored so a routine `git add` cannot accidentally stage
# this large binary artifact. Packaged as a debug-only jniLibs entry (the
# ONE binary source - see B45ANativeBinaryResolver), extracted by the
# Android package manager itself to `applicationInfo.nativeLibraryDir` at
# install time via a debug-only AGP Variant-API packaging fix
# (`packaging.jniLibs.useLegacyPackaging`, set only for the `debug` variant
# in android/app/build.gradle.kts - proven not to affect release packaging).
# The earlier debug-asset + filesDir-extraction design (see git history)
# was physically rejected on-device (real app-process exec denied,
# `error=13, Permission denied`) and is no longer used.
android/app/src/debug/jniLibs/arm64-v8a/libsslocal_spike.so

# B45B-3P - the production-named (never production-packaged - see
# docs/B45B3P_SHADOWSOCKS_PHYSICAL_VALIDATION.md) sslocal binary used ONLY to
# physically validate the production adapter shell through the debug-only
# validation harness. Same reproducible local build as the B45A spike binary
# above (same upstream commit, same cargo-ndk command - see the doc's own
# provenance section), packaged debug-only alongside it, under a distinct
# filename so the two are never confused. Not meant to ever be committed, for
# the same "large binary artifact, reproducible from a pinned source" reason
# as libsslocal_spike.so above.
android/app/src/debug/jniLibs/arm64-v8a/libsslocal.so

# B45A data-plane validation (round 6, see
# docs/B45A_SHADOWSOCKS_RUST_SPIKE.md) - disposable Frankfurt test server
# endpoint/credential (server, port, method, base64 key). Debug-buildType-
# only via android/app/build.gradle.kts, never committed, never printed.
android/app/b45a-dataplane.properties

# B45B Option A - APPROVED production packaging (see docs/ROADMAP.md's B45
# row). Same pinned sslocal binary as libsslocal.so above, placed under
# src/main/jniLibs so a real release build ships it. Never committed - same
# "large binary artifact, reproducible from a pinned source" reason as
# every other pinned binary above; a real release build/CI run must place
# it here locally before assembling release (see that ROADMAP row for the
# pinned upstream source/commit/hash).
android/app/src/main/jniLibs/arm64-v8a/libsslocal.so

# B46-2P - separate debug/research-only harness module (see
# docs/B46_2P_HYSTERIA2_ANDROID_PHYSICAL_VALIDATION.md). Locally-built
# artifacts only, all reproducible from pinned source under
# research/b46-2p-android-physical/ - never committed.
b46harness/local-libs/b46-tun2socks.aar
b46harness/src/main/jniLibs/arm64-v8a/libnovahysteria.so
b46harness/b46-hysteria-dataplane.properties
b46harness/build/
research/b46-2p-android-physical/**/*.aar
research/b46-2p-android-physical/**/novaminimal-android-arm64
research/b46-2p-android-physical/**/*.pem
research/b46-2p-android-physical/**/*.key
research/b46-2p-android-physical/**/*-sources.jar
