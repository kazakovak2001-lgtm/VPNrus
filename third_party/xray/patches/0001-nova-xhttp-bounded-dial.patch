diff --git a/transport/internet/splithttp/nova_dial_timeout_test.go b/transport/internet/splithttp/nova_dial_timeout_test.go
new file mode 100644
index 0000000..43f9097
--- /dev/null
+++ b/transport/internet/splithttp/nova_dial_timeout_test.go
@@ -0,0 +1,67 @@
+package splithttp
+
+import (
+	"context"
+	gotls "crypto/tls"
+	stdnet "net"
+	"testing"
+	"time"
+
+	xraytls "github.com/xtls/xray-core/transport/internet/tls"
+)
+
+func TestNovaXhttpDialTimeoutInterruptsStalledUTlsHandshake(t *testing.T) {
+	clientSide, peerSide := stdnet.Pipe()
+	defer peerSide.Close()
+
+	fingerprint := xraytls.GetFingerprint("chrome")
+	if fingerprint == nil {
+		t.Fatal("chrome fingerprint unavailable")
+	}
+
+	wrapped := xraytls.UClient(
+		clientSide,
+		&gotls.Config{
+			ServerName:         "example.com",
+			InsecureSkipVerify: true,
+		},
+		fingerprint,
+	)
+	conn, ok := wrapped.(*xraytls.UConn)
+	if !ok {
+		t.Fatalf("unexpected TLS client type %T", wrapped)
+	}
+	defer conn.Close()
+
+	parent := context.WithoutCancel(context.Background())
+	ctx, cancel := withXhttpDialTimeout(parent, 50*time.Millisecond)
+	defer cancel()
+
+	started := time.Now()
+	err := conn.HandshakeContext(ctx)
+	elapsed := time.Since(started)
+
+	if err == nil {
+		t.Fatal("stalled TLS peer unexpectedly completed a handshake")
+	}
+	if elapsed > time.Second {
+		t.Fatalf("stalled handshake outlived bounded dial context: %s", elapsed)
+	}
+}
+
+func TestNovaXhttpDialTimeoutPreservesEarlierParentDeadline(t *testing.T) {
+	parent, parentCancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer parentCancel()
+
+	ctx, cancel := withXhttpDialTimeout(parent, 5*time.Second)
+	defer cancel()
+
+	parentDeadline, parentOK := parent.Deadline()
+	childDeadline, childOK := ctx.Deadline()
+	if !parentOK || !childOK {
+		t.Fatal("both parent and bounded child must carry deadlines")
+	}
+	if childDeadline.After(parentDeadline) {
+		t.Fatalf("child deadline %s extended earlier parent deadline %s", childDeadline, parentDeadline)
+	}
+}
